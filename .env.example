# ==========================================================================
# BetChess ZW - environment
#
# Copy to .env and fill in. Nothing here is required to run: with no
# credentials the app boots in SANDBOX mode (payments settle automatically,
# engine runs locally) so you can play and demo the whole flow immediately.
# ==========================================================================

# ---------- Server ----------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Public HTTPS origin of this deployment. EcoCash and the other wallets use it
# to build the callback URL, so it must be reachable from the internet.
BASE_URL=https://yourdomain.com

# ---------- Admin ----------
# Password for /admin. CHANGE THIS.
ADMIN_PASSWORD=admin123ZW

# ---------- Payments ----------
# mock = sandbox (default, no credentials needed, deposits/withdrawals settle
#        automatically so the full flow is testable)
# live = real money. Every provider needs its credentials filled in below.
PAYMENT_MODE=mock

# How long the sandbox waits before "the customer approves on the handset".
MOCK_SETTLEMENT_DELAY_MS=2500
# Fraction of sandbox transactions that should fail (0..1) - useful for testing
# the failure/refund paths.
MOCK_FAILURE_RATE=0

# Live providers poll the gateway as a safety net in case a callback is missed.
PAYMENT_POLL_INTERVAL_MS=30000

# ---- EcoCash (Cassava / Econet) - the primary wallet ----
# Leave blank to run EcoCash in sandbox mode.
ECOCASH_ENABLED=true
ECOCASH_BASE_URL=https://developers.ecocash.co.zw
ECOCASH_MERCHANT_CODE=
ECOCASH_API_KEY=
# oauth2 (client id/secret) | apikey (X-API-KEY header) | bearer (static key)
ECOCASH_AUTH_MODE=oauth2
ECOCASH_CLIENT_ID=
ECOCASH_CLIENT_SECRET=
ECOCASH_API_KEY_HEADER=X-API-KEY
# Endpoint paths - confirm against the EcoCash merchant docs you were issued.
ECOCASH_TOKEN_PATH=/api/v1/oauth/token
ECOCASH_C2B_PATH=/api/v1/payments/c2b
ECOCASH_B2C_PATH=/api/v1/payments/b2c
ECOCASH_STATUS_PATH=/api/v1/payments/status
# Shared secret used to sign callbacks (HMAC-SHA256 of the raw body).
# If it is empty, live callbacks are REJECTED (fail closed).
ECOCASH_WEBHOOK_SECRET=
ECOCASH_SIGNATURE_HEADER=x-signature
ECOCASH_CURRENCY=USD
ECOCASH_MIN_AMOUNT=0.50
ECOCASH_MAX_AMOUNT=2000
ECOCASH_TIMEOUT_MS=15000

# ---- InnBucks ----
INNBUCKS_ENABLED=false
INNBUCKS_BASE_URL=
INNBUCKS_MERCHANT_CODE=
INNBUCKS_API_KEY=
INNBUCKS_CLIENT_ID=
INNBUCKS_CLIENT_SECRET=
INNBUCKS_AUTH_MODE=oauth2
INNBUCKS_TOKEN_PATH=/api/v1/oauth/token
INNBUCKS_C2B_PATH=/api/v1/payments/c2b
INNBUCKS_B2C_PATH=/api/v1/payments/b2c
INNBUCKS_STATUS_PATH=/api/v1/payments/status
INNBUCKS_WEBHOOK_SECRET=

# ---- OneMoney (NetOne) ----
ONEMONEY_ENABLED=false
ONEMONEY_BASE_URL=
ONEMONEY_MERCHANT_CODE=
ONEMONEY_API_KEY=
ONEMONEY_CLIENT_ID=
ONEMONEY_CLIENT_SECRET=
ONEMONEY_AUTH_MODE=oauth2
ONEMONEY_TOKEN_PATH=/api/v1/oauth/token
ONEMONEY_C2B_PATH=/api/v1/payments/c2b
ONEMONEY_B2C_PATH=/api/v1/payments/b2c
ONEMONEY_STATUS_PATH=/api/v1/payments/status
ONEMONEY_WEBHOOK_SECRET=

# ---- Bank transfer / Zimswitch (settled manually, approved in /admin) ----
BANK_NAME=CBZ Bank
BANK_ACCOUNT_NAME=BetChess ZW (Pvt) Ltd
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=Harare

# ---------- Engine ----------
# Lichess Stockfish 18 wasm build (npm @lichess-org/stockfish-web).
# Options: sf18-smallnet (default, self-contained ~600KB) | sf18 |
#          sf18-smallnet-simd | sf18-simd | sfdev-smallnet
ENGINE_VARIANT=sf18-smallnet
ENGINE_HASH=64
ENGINE_THREADS=1
# Set ENGINE_DEBUG=1 to log every engine request (useful, noisy).
# ENGINE_DEBUG=1

# Lichess cloud eval (https://lichess.org/api/cloud-eval) - deep cached analyses
# used for the Master/Grandmaster tiers, the eval bar and anti-cheat scoring.
# No API key needed. If lichess.org is unreachable the app degrades silently.
LICHESS_CLOUD_EVAL=true
LICHESS_CLOUD_FOR_MOVES=true
LICHESS_CLOUD_TIMEOUT_MS=2500

# Anti-cheat: every move in a real-money game is scored against the engine.
ANTI_CHEAT=true
ANTI_CHEAT_MOVETIME_MS=220

# ---------- LLM Arena (optional) ----------
# Users bring their own keys in the UI; these are only defaults.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
