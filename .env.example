# Rookstone Arena — deployment template. Copy to .env for local development.
# NEVER commit a populated .env, provider secrets, or compliance keys.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# Browser origin used in links and CSRF checks. In production use the exact HTTPS origin.
PUBLIC_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
LOG_LEVEL=info
# Required in production: at least 32 random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
SESSION_TTL_HOURS=336

# --------------------------------------------------------------- database
# Production: use managed PostgreSQL. Migrations run automatically at boot.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rookstone?sslmode=require
# DB_POOL_SIZE=12
# Local zero-service mode uses embedded PostgreSQL (PGlite) in this directory.
DB_DRIVER=pglite
PGLITE_DIR=./data/pglite
# Only for an intentional single-node production installation.
ALLOW_EMBEDDED_DB=false

# ------------------------------------------------------------ competitions
# free = free chess only; test = isolated, clearly labelled internal test credits;
# real = DISABLED until every legal/provider/age prerequisite below is verified.
OPERATING_MODE=free
TEST_FUNDS_ENABLED=false
# Both flags are necessary but NOT sufficient for real mode.
LEGAL_AUTHORISATION_VERIFIED=false
PROVIDER_MERCHANT_APPROVAL_VERIFIED=false
AGE_VERIFICATION_PROVIDER=
AGE_VERIFICATION_WEBHOOK_SECRET=

# Signed human approval manifest and separate signing key. The key must not live
# in the same secret store as the application deploy credentials.
COMPLIANCE_ACTIVATION_PATH=./config/compliance-activation.json
COMPLIANCE_SIGNING_KEY=

# Evidence used by `npm run compliance:draft` to build the activation manifest.
# Record real, independently verified references only. See docs/GO-LIVE.md.
COMPLIANCE_JURISDICTION=ZW
COMPLIANCE_LEGAL_OPINION_REF=
COMPLIANCE_LICENCE_REF=
COMPLIANCE_PROVIDER_APPROVAL_REF=
COMPLIANCE_AML_OFFICER_REF=
COMPLIANCE_APPROVED_BY=
COMPLIANCE_APPROVED_AT=
COMPLIANCE_EXPIRES_AT=

# ------------------------------------------------------------ secure email
# Password reset and email verification require working SMTP. The server never
# reports an undelivered message as sent. See docs/EMAIL.md.
# Pick one form (first match wins):
#   1. Gmail:  EMAIL_PROVIDER=gmail + SMTP_USER + SMTP_PASS (16-char App Password)
#   2. SMTP:   EMAIL_PROVIDER=smtp  + SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS
#   3. DSN:    SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_PROVIDER=gmail
SMTP_USER=
# Gmail requires 2-Step Verification and an App Password, never the normal password.
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465            # 465 = implicit TLS, 587 = STARTTLS
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=false
# SMTP_URL=
# Must match SMTP_USER for Gmail (otherwise Gmail rewrites the sender).
EMAIL_FROM=Rookstone Arena <no-reply@example.invalid>
# Optional reply-to shown to players who answer a security email.
EMAIL_REPLY_TO=
# Verify delivery with: npm run email:test -- you@gmail.com

# --------------------------------------------------------------- Stockfish
ENGINE_ENABLED=true
ENGINE_MAX_CONCURRENT=2
ENGINE_MAX_DEPTH=18
ENGINE_MAX_TIME_MS=1500

# ------------------------------------------------------- Paynow (Zimbabwe)
# Docs: https://developers.paynow.co.zw/docs/paynow/initiate_transaction/
PAYNOW_ENABLED=false
PAYNOW_LIVE=false
PAYNOW_MERCHANT_APPROVED=false
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Production default: https://www.paynow.co.zw
PAYNOW_BASE_URL=https://www.paynow.co.zw

# ------------------------------------------------------ EcoCash (Zimbabwe)
# Docs: https://developers.ecocash.co.zw/docs
ECOCASH_ENABLED=false
ECOCASH_SANDBOX=true
ECOCASH_MERCHANT_APPROVED=false
# EPG serviceRequest endpoint for Merchant-to-Subscriber payouts.
ECOCASH_BASE_URL=https://developers.ecocash.co.zw/api/serviceRequest
ECOCASH_CLIENT_ID=
ECOCASH_CLIENT_SECRET=
ECOCASH_API_USERNAME=
# Generate this encrypted channel password on the EcoCash credentials page.
ECOCASH_EPG_ENCRYPTED_PASSWORD=
# Instant Payments (customer PIN prompt). Never collect or store a customer PIN.
ECOCASH_EIP_BASE_URL=https://developers.ecocash.co.zw/sandbox/payment/v1
ECOCASH_EIP_USERNAME=
ECOCASH_EIP_PASSWORD=
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_API_PIN=
ECOCASH_MERCHANT_NUMBER=
ECOCASH_TERMINAL_ID=
ECOCASH_MERCHANT_NAME=
ECOCASH_SUPER_MERCHANT_NAME=
ECOCASH_WEBHOOK_SECRET=

# ------------------------------------------------ Pesepay (Zimbabwe gateway)
# Docs: https://developers.pesepay.com/getting-started/overview/
PESEPAY_ENABLED=false
PESEPAY_SANDBOX=true
PESEPAY_MERCHANT_APPROVED=false
# Sandbox default: https://api.test.sandbox.pesepay.com/payments-engine/v1/payments
# Production:      https://api.pesepay.com/api/payments-engine/v1/payments
PESEPAY_BASE_URL=
PESEPAY_INTEGRATION_KEY=
# Exactly 32 characters; used as AES-256-CBC key and first-16-character IV.
PESEPAY_ENCRYPTION_KEY=

# --------------------------------------------- OneMoney / other providers
# No verified public direct merchant API contract is bundled; use an approved
# aggregator such as Paynow after the aggregator approves the merchant account.
ONEMONEY_ENABLED=false
ONEMONEY_SANDBOX=true
ONEMONEY_MERCHANT_ID=
ONEMONEY_API_KEY=
ONEMONEY_BASE_URL=
ONEMONEY_WEBHOOK_SECRET=

# -------------------------------------------------------- bootstrap admin
# Set only when running `npm run bootstrap:admin`; never leave in production env.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
FORCE_ADMIN_UPDATE=false
