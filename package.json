{
  "name": "chess-bet-zw",
  "version": "2.0.0",
  "description": "BetChess ZW - real-money chess with the Lichess Stockfish 18 engine and EcoCash payments",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch lib --watch public server.js",
    "postinstall": "node scripts/vendor-assets.mjs || true",
    "vendor": "node scripts/vendor-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "engine:bench": "node scripts/engine-bench.cjs"
  },
  "dependencies": {
    "@lichess-org/stockfish-web": "^0.4.4",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.7.5"
  }
}
