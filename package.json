{
  "name": "rookstone-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rookstone Arena - competitive online chess with an authoritative server, double-entry ledger and compliance-gated competitions",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "npm run test:unit && npm run test:integration && npm run test:ui && npm run test:e2e && npm run test:browser",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "migrate": "tsx server/db/migrate.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "vendor:engine": "node scripts/vendor-engine.mjs",
    "postinstall": "node scripts/vendor-engine.mjs",
    "test:browser": "npm run build:server && npm run build:web && node tests/browser.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@node-rs/argon2": "2.2.2",
    "@tanstack/react-query": "5.105.0",
    "chess.js": "1.4.0",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "4.21.2",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "nodemailer": "7.0.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.2.0",
    "react-chessboard": "5.12.1",
    "react-dom": "19.2.0",
    "react-router-dom": "6.30.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "stockfish": "19.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
